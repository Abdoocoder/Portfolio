# Firebase Configuration
# Replace these values with your actual Firebase project settings
# These are PUBLIC variables, they will be embedded in the JS bundle.
# Secure them using Domain Restrictions in Google Cloud Console.
# Firebase project: abdoocoderportfolio
# email: abdooraf3@gmail.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-your_measurement_id
# Contact Form (Formspree)
# Create a form at https://formspree.io/ and put the endpoint URL here
# email: abdullahabusaghierh@my.uopeople.edu
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/your_id
# Project Vault — GitHub Gist storage
# NEXT_PUBLIC_GIST_ID is the ID from your gist URL: gist.github.com/{user}/{id}
# GIST_TOKEN is a GitHub PAT with only the `gist` scope (server-side only, no NEXT_PUBLIC_)
NEXT_PUBLIC_GIST_ID=your_gist_id
GIST_TOKEN=your_github_token
